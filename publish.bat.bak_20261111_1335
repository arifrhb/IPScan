@echo off
echo ==============================================
echo Building and Publishing IPScan...
echo ==============================================

dotnet publish IPScan.csproj /p:PublishProfile=FolderProfile-SelfContained
if %ERRORLEVEL% NEQ 0 (
    echo [ERROR] Self-contained publish failed.
    exit /b %ERRORLEVEL%
)

echo.
dotnet publish IPScan.csproj /p:PublishProfile=FolderProfile-LightWeight
if %ERRORLEVEL% NEQ 0 (
    echo [ERROR] Light-weight publish failed.
    exit /b %ERRORLEVEL%
)

echo.
echo ==============================================
echo Publish complete!
echo Output locations:
echo   - Self-contained:       publish\self-contained\IPScan.exe
echo   - Light-weight:  		publish\Light-weight\IPScan.exe
echo ==============================================

